# =============================================
# AI Digital Tutor — Environment Variables
# Copy to .env and fill in real values.
# =============================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017        # Connection string (local or Atlas)
DB_NAME=ai_tutor                             # Database name

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-random-64-char-string   # Used to sign JWT tokens

# --- App URL (absolute links in verification / reset emails) ---
# e.g. http://localhost:5173 (dev) or https://app.example.com (prod)
APP_BASE_URL=

# --- Google sign-in (Google Identity Services) ---
# OAuth 2.0 Client ID from Google Cloud Console (Web application).
# Same value goes to the frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- LLM Provider API Keys — Mistral + Groq only, numbered for load balancing ---
# Add up to N keys per provider; requests round-robin across them for higher
# rate-limit headroom + lower latency. Set at least one key total.
# Groq: use keys from DIFFERENT accounts/orgs for real extra headroom.
MISTRAL_API_KEY_1=                           # Mistral AI key #1
MISTRAL_API_KEY_2=                           # Mistral AI key #2
MISTRAL_API_KEY_3=                           # Mistral AI key #3
GROQ_API_KEY_1=                              # Groq Cloud key #1
GROQ_API_KEY_2=                              # Groq Cloud key #2
GROQ_API_KEY_3=                              # Groq Cloud key #3
# Legacy single-key names still work as a fallback:
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000   # Comma-separated frontend origins

# --- App mode ---
ENVIRONMENT=development                      # Set to "production" to disable /docs
AUTO_ENSURE_INDEXES=1                        # W5: set 0 in prod; run `python -m scripts.migrate_indexes` at deploy instead
USER_CACHE_TTL_SECONDS=30                    # W5: cache the auth user lookup per worker (0 disables)

# --- W5: telemetry retention (scripts/telemetry_maintenance.py) ---
RETAIN_INTERACTIONS_DAYS=90                   # prune interactions older than N days (0 = keep)
RETAIN_LLM_CALLS_DAYS=30                      # prune llm_calls older than N days
RETAIN_RL_TRANSITIONS_DAYS=180                # prune rl_transitions older than N days

# --- W5: Mongo auth (docker-compose.prod.yml). Use a secret store, not this file. ---
MONGO_ROOT_USER=                             # e.g. ai_tutor_admin
MONGO_ROOT_PASSWORD=                         # strong random password

# --- RL tuning (optional, defaults in code) ---
RL_MIN_BUFFER=500                            # Min replay buffer size before training
RL_SERVE_EPSILON=0.0                         # Exploration rate in production (0 = greedy)

# --- Observability (optional) ---
SENTRY_DSN=                                  # Sentry DSN for error tracking (no-op if blank)
SENTRY_TRACES_RATE=0.1                       # Sentry performance traces sample rate (0.0–1.0)
LOG_FORMAT=                                  # W8: "json" for structured logs (ELK/Loki); blank = text
LOG_LEVEL=INFO                               # W8: root log level
# W8: Prometheus metrics are served at /metrics (no key needed).

# --- Rate limiting & LLM budget ---
RATE_LIMIT_DEFAULT=120/minute                # Global per-IP default rate limit
LLM_DAILY_REQUEST_CAP=300                    # Max LLM-endpoint requests per user per day
# SEC H-4: shared store so limits hold across workers/replicas. Optional in dev
# (in-memory single process); REQUIRED in production or the app refuses to boot.
RATE_LIMIT_STORAGE_URI=                      # e.g. redis://redis:6379  (or async+redis://redis:6379)

# --- Resource links (N11/F3, optional — labeled search links without keys) ---
YOUTUBE_API_KEY=                             # Google Cloud > YouTube Data API v3
TAVILY_API_KEY=                              # tavily.com — article search
SEMANTIC_SCHOLAR_KEY=                        # optional, raises rate limits for papers

# --- Email: ONE service — SMTP, sent from the FRONTEND via EmailJS ---
# Browsers can't speak SMTP, so connect your SMTP account (Gmail app
# password etc.) inside EmailJS (emailjs.com) and set these 3 VITE_ vars in
# the VERCEL dashboard. Backend never sends mail — it only generates links.
VITE_EMAILJS_SERVICE_ID=                       # EmailJS service id
VITE_EMAILJS_TEMPLATE_ID=                      # EmailJS template id
VITE_EMAILJS_PUBLIC_KEY=                       # EmailJS public key (browser-safe)

# --- W3: Auth hardening (optional; sensible defaults in code) ---
LOGIN_MAX_FAILURES=5                          # failed logins before lockout
LOGIN_LOCKOUT_SECONDS=900                     # lockout duration (15 min)
LOGIN_WINDOW_SECONDS=900                      # inactivity window before counters reset
RESET_TOKEN_TTL_SECONDS=3600                  # password-reset link lifetime (1h)
VERIFY_TOKEN_TTL_SECONDS=86400                # email-verify link lifetime (24h)
