# ============================================================
# Digital Tutor — User Service (Vercel Auth Gateway) Environment
# ============================================================

# --- Required ---
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
DB_NAME=digital_tutor

# --- Auth Token Lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFY_TOKEN_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=3600

# --- Rate Limiting (Redis required in production) ---
ENVIRONMENT=development
RATE_LIMIT_STORAGE_URI=redis://localhost:6379
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_DISABLED=0

# --- LLM Budget (shared with adaptive) ---
LLM_DAILY_REQUEST_CAP=300

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (Brevo) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Digital Tutor

# --- App URLs ---
APP_BASE_URL=https://your-app.vercel.app

# --- Google OAuth ---
GOOGLE_CLIENT_ID=745630350470-t1u0284paetosdvuhsq7j022l0tljkiv.apps.googleusercontent.com

# --- Adaptive Engine (Render) ---
ADAPTIVE_ENGINE_URL=https://your-adaptive-engine.onrender.com

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
LOG_FORMAT=json

# --- E2E Testing ---
E2E_AUTO_VERIFY=0

# --- Database Index Migration ---
AUTO_ENSURE_INDEXES=1

# --- Login Guard ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15