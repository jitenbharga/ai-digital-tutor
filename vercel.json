{
  "version": 2,
  "builds": [
    {
      "src": "user/serve.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.11" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "user/serve.py" }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "PYTHONPATH": "."
  },
  "functions": {
    "user/serve.py": {
      "maxDuration": 30
    }
  }
}